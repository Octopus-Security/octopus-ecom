{
  "name": "octopus-ecom",
  "version": "0.1.0",
  "description": "Print-on-demand pipeline console: brief -> original design -> mockup -> listing draft -> human approval -> published, with per-product unit economics.",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "start": "node scripts/ensure-client.mjs && node server/index.js",
    "dev": "node --watch server/index.js & vite --config client/vite.config.mjs",
    "build": "vite build --config client/vite.config.mjs",
    "test": "node --test 'test/*.test.js'"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "optionalDependencies": {
    "@octopus-security/auth-client": "^1.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=22"
  }
}
