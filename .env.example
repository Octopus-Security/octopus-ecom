# Every key is OPTIONAL. With none set, `npm start` runs in dry-run with all
# adapters stubbed. Credentials may instead be entered in the panel's Settings
# drawer, where they are sealed with ECOM_SECRET; env values are never written
# to the database. Never commit a real .env.

# --- Process ---
# NODE_ENV=production        # production REQUIRES ECOM_SECRET, AUTH_MODE=sso, OWNER_USERNAMES
# PORT=3050                  # default 3050
# DATA_DIR=./data            # database, images, dev secret (gitignored)

# --- Encryption ---
# ECOM_SECRET=               # >=16 chars. Seals the keystore. Required in production.
                             # Unset in dev: a random one is generated into DATA_DIR/.dev-secret.
                             # Losing it makes sealed credentials unreadable (re-enter them).

# --- Auth ---
# AUTH_MODE=dev              # dev (default outside production) | sso (required in production)
# DEV_USER=owner             # username used in dev mode
# OWNER_USERNAMES=           # comma-separated; required in sso mode
# AUTH_SERVICE_URL=          # sso: where to verify sessions
# AUTH_PUBLIC_URL=           # sso: login redirect base
# APP_ACCESS_SLUG=           # sso: optional central per-app access gate

# --- Safety ---
# DRY_RUN=true               # seed value only; the panel owns it afterwards. Only false/0/off disarms.
# DAILY_SPEND_CAP=5          # dollars per ET day; pauses generation when reached
# MARGIN_FLOOR=2             # dollars; projected unit margin below this FLAGS a product

# --- Credentials (each optional; panel Settings can hold them instead) ---
# OPENAI_API_KEY=            # image generation / LLM
# PRINTIFY_API_TOKEN=        # Printify API
# ETSY_API_KEY=              # Etsy Open API keystring
# ETSY_SHARED_SECRET=        # Etsy shared secret
# ETSY_REDIRECT_URI=         # OAuth redirect, e.g. http://127.0.0.1:3050/api/etsy/callback

# --- LLM ---
# LLM_PROVIDER=              # stub | openai | openai-compatible (default: stub until a provider is usable)
# LLM_BASE_URL=              # openai-compatible endpoint
# LLM_API_KEY=               # openai-compatible key, if it needs one
# LLM_MODEL_CHEAP=           # model for the cheap tier (also LLM_MODEL_STANDARD, LLM_MODEL_DEEP); wins over ROUTER_PATH
# LLM_PRICE_IN_PER_M=        # dollars per 1M input tokens, for models the built-in price table does not know
# LLM_PRICE_OUT_PER_M=       # dollars per 1M output tokens (set both)
# ROUTER_PATH=               # optional path to a router checkout; read for its tier table only

# --- Image generation ---
# IMAGE_MODEL=gpt-image-1    # must have an entry in server/adapters/imagegen/pricing.js
# IMAGE_QUALITY=high         # low | medium | high (cost rises steeply)
# IMAGE_UPSCALE=true         # false keeps the model's native size (no resample); the stored size is always the real one
